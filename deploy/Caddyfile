{
	# TLS for service.artepersia.com is terminated by the server's edge Caddy
	# (the PersonalWallet stack owns ports 80/443). This Caddy only serves the PWA
	# and proxies the API on the shared Docker network.
	auto_https off
	admin off
	servers {
		# Only the edge proxy on a private Docker network may set X-Forwarded-For.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Photos are up to 6 MB (compressed on the phone first); everything else stays small at the API.
	request_body {
		max_size 8MB
	}

	handle /api/* {
		reverse_proxy arte-api:8080 {
			# One value: the real client IP as resolved through the trusted edge proxy.
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
