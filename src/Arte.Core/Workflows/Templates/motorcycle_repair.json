{
  "key": "motorcycle_repair",
  "name": "پذیرش و تعمیر وسیله نقلیه",
  "stages": [
    { "key": "received",          "name": "پذیرش شد",            "category": "open",      "color": "gray" },
    { "key": "diagnosing",        "name": "در حال عیب‌یابی",      "category": "active",    "color": "blue" },
    { "key": "awaiting_approval", "name": "منتظر تأیید مشتری",   "category": "waiting",   "color": "orange", "setting": "RequireCustomerApproval" },
    { "key": "awaiting_parts",    "name": "منتظر قطعه",           "category": "waiting",   "color": "orange" },
    { "key": "repairing",         "name": "در حال تعمیر",         "category": "active",    "color": "blue" },
    { "key": "review",            "name": "بررسی نهایی استاد",    "category": "active",    "color": "blue",   "setting": "RequireFinalReview" },
    { "key": "ready",             "name": "آماده تحویل",          "category": "done",      "color": "green" },
    { "key": "delivered",         "name": "تحویل شد",             "category": "done",      "color": "teal", "terminal": true },
    { "key": "cancelled",         "name": "انصراف",               "category": "cancelled", "color": "red",  "terminal": true }
  ],
  "transitions": [
    { "from": "received",          "to": "diagnosing",        "label": "شروع عیب‌یابی",                       "primary": true, "permission": "cases.work" },
    { "from": "received",          "to": "repairing",         "label": "شروع تعمیر",                          "permission": "cases.work" },
    { "from": "received",          "to": "cancelled",         "label": "انصراف",                              "reason": true,  "permission": "cases.create" },
    { "from": "diagnosing",        "to": "awaiting_approval", "label": "ارسال برای تأیید مشتری",              "primary": true, "permission": "cases.work" },
    { "from": "diagnosing",        "to": "repairing",         "label": "شروع تعمیر",                          "permission": "cases.work" },
    { "from": "diagnosing",        "to": "awaiting_parts",    "label": "منتظر قطعه",                          "permission": "cases.work" },
    { "from": "diagnosing",        "to": "cancelled",         "label": "انصراف",                              "reason": true,  "permission": "cases.create" },
    { "from": "awaiting_approval", "to": "repairing",         "label": "مشتری تأیید کرد",                     "primary": true, "permission": "cases.work" },
    { "from": "awaiting_approval", "to": "cancelled",         "label": "مشتری رد کرد",                        "reason": true,  "permission": "cases.create" },
    { "from": "repairing",         "to": "review",            "label": "پایان کار؛ ارسال برای بررسی استاد",   "primary": true, "permission": "cases.work" },
    { "from": "repairing",         "to": "ready",             "label": "پایان کار؛ آماده تحویل",              "permission": "cases.work", "unless": "review" },
    { "from": "repairing",         "to": "awaiting_parts",    "label": "منتظر قطعه",                          "permission": "cases.work" },
    { "from": "awaiting_parts",    "to": "repairing",         "label": "قطعه رسید",                           "primary": true, "permission": "cases.work" },
    { "from": "review",            "to": "ready",             "label": "تأیید کار؛ اطلاع به مشتری برای تحویل", "primary": true, "permission": "cases.create" },
    { "from": "review",            "to": "repairing",         "label": "نیاز به کار بیشتر",                   "reason": true,  "permission": "cases.create" },
    { "from": "ready",             "to": "delivered",         "label": "ثبت تحویل",                           "primary": true, "permission": "cases.create" },
    { "from": "delivered",         "to": "received",          "label": "بازگشایی در ضمانت",                   "reason": true,  "permission": "cases.create" }
  ]
}
